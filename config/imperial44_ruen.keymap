#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&mt {
    quick-tap-ms = <200>;
    require-prior-idle-ms = <125>;
    flavor = "tap-preferred";
};

/ {
    combos {
        compatible = "zmk,combos";

        left_1 {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <4 5>;
            layers = <0 2>;
        };

        left_2 {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <16 17>;
            layers = <0 2>;
        };

        left_3 {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <28 29>;
            layers = <0 2>;
        };

        r_1 {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <6 7>;
            layers = <0 2>;
        };

        r_2 {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <18 19>;
            layers = <0 2>;
        };

        r_3 {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <32 33>;
            layers = <0 2>;
        };

        r_one {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <16 15>;
            layers = <0 2>;
        };

        l_minus {
            bindings = <&kp MINUS>;
            key-positions = <28 27>;
            layers = <0 2>;
        };

        l_tt {
            bindings = <&kp COLON>;
            key-positions = <8 7>;
            layers = <0 2>;
        };

        r_t {
            bindings = <&kp SEMI>;
            key-positions = <4 3>;
            layers = <0 2>;
        };

        l_ru_1 {
            bindings = <&kp RU_LPAR>;
            key-positions = <4 5>;
            layers = <1 3>;
        };

        l_r_2 {
            bindings = <&en LEFT_BRACKET>;
            key-positions = <16 17>;
            layers = <1 3>;
        };

        l_r_3 {
            bindings = <&en LEFT_BRACE>;
            key-positions = <28 29>;
            layers = <1 3>;
        };

        l_r_mi {
            bindings = <&kp RU_MINUS>;
            key-positions = <28 27>;
            layers = <1 3>;
        };

        l_r_toddot {
            bindings = <&kp RU_COLON>;
            key-positions = <7 8>;
            layers = <1 3>;
        };

        r_ru_1 {
            bindings = <&kp RU_RPAR>;
            key-positions = <6 7>;
            layers = <1 3>;
        };

        r_ru_2 {
            bindings = <&en RIGHT_BRACKET>;
            key-positions = <18 19>;
            layers = <1 3>;
        };

        r_ru_3 {
            bindings = <&en RIGHT_BRACE>;
            key-positions = <32 33>;
            layers = <1 3>;
        };

        r_ru_to_dot {
            bindings = <&kp RU_SEMICOLON>;
            key-positions = <4 3>;
            layers = <1 3>;
        };

        r_ru_sq {
            bindings = <&en SQT>;
            key-positions = <16 15>;
            layers = <1 3>;
        };

        e_ru {
            bindings = <&kp RU_CYRILLIC_IO>;
            key-positions = <1 2>;
            layers = <1 3>;
        };
    };

    macros {
        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N2))>;
            label = "TO_RU";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N1))>;
            label = "TO_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &to_en>;
            label = "LAYER_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &to_ru>;
            label = "LAYER_RU";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&to_en>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to_ru>;

            label = "EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };
    };

    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <225>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <10 9 8 7 6 18 19 21 22 34 20 35 36 33 32 43 42 41 31 11 23 37>;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <225>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 29 16 17 30 15 14 13 12 24 25 26 27 28 38 39 40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
&kp ESC        &kp Q  &kp W  &kp E  &kp R      &kp T                                              &kp Y  &kp U             &kp I  &kp O  &none  &none
&kp TAB        &kp A  &kp S  &kp D  &kp F      &kp G                                              &kp H  &kp J             &kp K  &kp L  &kp P  &none
&kp BACKSPACE  &kp Z  &kp X  &kp C  &kp V      &kp B  &kp ENTER                 &kp C_PLAY_PAUSE  &kp N  &kp M             &none  &none  &none  &none
                                    &kp LSHFT  &mo 2  &mt LEFT_COMMAND SPACE    &kp LEFT_ALT      &mo 4  &kp LEFT_CONTROL
            >;

            display-name = "En";
            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        ru {
            display-name = "Ru";
            bindings = <
&kp ESC        &kp RU_CYRILLIC_SHORT_I  &kp RU_CYRILLIC_TSE   &kp RU_CYRILLIC_U   &kp RU_CYRILLIC_KA  &kp RU_CYRILLIC_IE                                              &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE        &kp RU_CYRILLIC_SHA  &kp RU_CYRILLIC_SHCHA  &kp RU_CYRILLIC_ZE   &kp RU_CYRILLIC_HA
&kp TAB        &kp RU_CYRILLIC_EF       &kp RU_CYRILLIC_YERU  &kp RU_CYRILLIC_VE  &kp RU_CYRILLIC_A   &kp RU_CYRILLIC_PE                                              &kp RU_CYRILLIC_ER  &kp RU_CYRILLIC_O          &kp RU_CYRILLIC_EL   &kp RU_CYRILLIC_DE     &kp RU_CYRILLIC_ZHE  &kp RU_CYRILLIC_HARD_SIGN
&kp BACKSPACE  &kp RU_CYRILLIC_YA       &kp RU_CYRILLIC_CHE   &kp RU_CYRILLIC_ES  &kp RU_CYRILLIC_EM  &kp RU_CYRILLIC_I   &kp ENTER                 &kp C_PLAY_PAUSE  &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE   &kp RU_CYRILLIC_YU     &kp RU_CYRILLIC_E    &none
                                                                                  &kp LEFT_SHIFT      &mo 3               &mt LEFT_COMMAND SPACE    &kp LEFT_ALT      &mo 4               &kp LCTRL
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sym_en {
            bindings = <
&none  &kp N1    &kp N2       &kp N3     &kp N4         &kp N5                                &kp N6     &kp N7         &kp N8     &kp N9     &kp N0    &none
&none  &kp EXCL  &kp AT_SIGN  &kp POUND  &kp DOLLAR     &kp PERCENT                           &kp CARET  &kp AMPERSAND  &kp ASTRK  &kp EQUAL  &kp PLUS  &none
&none  &none     &kp GRAVE    &kp TILDE  &kp LESS_THAN  &kp GREATER_THAN  &none    &none      &kp FSLH   &kp BSLH       &kp PIPE   &none      &none     &none
                                         &mo 5          &none             &none    &kp COMMA  &kp DOT    &kp QUESTION
            >;

            display-name = "Symbols_En";
            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        sym_ru {
            display-name = "Symbols_Ru";
            bindings = <
&none  &kp N1              &kp N2       &kp N3     &kp N4         &kp N5                                   &kp N6        &kp N7            &kp N8           &kp N9        &kp N0       &none
&none  &kp RU_EXCLAMATION  &en AT_SIGN  &en HASH   &en DOLLAR     &kp RU_PERCENT                           &en CARET     &en AMPERSAND     &kp RU_ASTERISK  &kp RU_EQUAL  &kp RU_PLUS  &none
&none  &none               &en GRAVE    &en TILDE  &en LESS_THAN  &en GREATER_THAN  &none    &none         &kp RU_SLASH  &kp RU_BACKSLASH  &en PIPE         &none         &none        &none
                                                   &mo 5          &none             &none    &kp RU_COMMA  &kp RU_DOT    &kp RU_QUESTION
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        nav {
            bindings = <
&none         &none           &none             &none         &none             &none                      &kp HOME        &kp PAGE_DOWN   &kp PG_UP  &kp END          &none  &none
&none         &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_COMMAND  &none                      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP     &kp RIGHT_ARROW  &none  &none
&kp CAPSLOCK  &none           &none             &none         &none             &none      &none    &none  &kp C_PREV      &kp DELETE      &kp INS    &kp C_NEXT       &none  &none
                                                              &layer_en         &layer_ru  &none    &none  &none           &none
            >;

            display-name = "Navigation";
        };

        adj {
            bindings = <
&none  &kp F1  &kp F2   &kp F3   &kp F4   &none                        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&none  &kp F5  &kp F6   &kp F7   &kp F8   &none                        &out OUT_BLE  &none         &none             &none         &none         &studio_unlock
&none  &kp F9  &kp F10  &kp F11  &kp F12  &none  &bootloader    &none  &out OUT_USB  &kp K_PREV    &kp K_PLAY_PAUSE  &kp K_NEXT    &none         &none
                                 &none    &none  &none          &none  &none         &none
            >;

            display-name = "Adjust";
        };
    };
};
